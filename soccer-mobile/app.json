{
  "expo": {
    "name": "soccer-mobile",
    "slug": "soccer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "soccermobile",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nakov.soccermobile"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbb40e6c-6e43-43df-83f6-001444cc7e88"
      }
    }
  }
}
